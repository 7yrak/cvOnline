[Unit]
Description=CV Online de Sergio Fica
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tyrak
Group=tyrak
WorkingDirectory=/home/tyrak/proyectos/cv-online/current
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
Environment=HOSTNAME=0.0.0.0
Environment=PORT=3080
EnvironmentFile=-/home/tyrak/proyectos/cv-online/.env.production
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
